<html>
  <head>
    <title><%=title%></title>
  </head>
  <body>
    <div>
      <a href="/new">new</a>
    </div>
    <%if (!locals.messages || messages.length===0) {%>
    <h3>No messages yet ? Be the first one</h3>
    <%} else {%>
    <div>
      <% messages.forEach(msg=>{%>
      <h1><%=msg.username%></h1>
      <p><%=msg.message%></p>
      <p><%= msg.created_at%></p>
      <a href="/<%=msg.id%>">Open</a>
    </div>
    <%})}%>
  </body>
</html>
